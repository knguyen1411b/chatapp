{
  "name": "chatapp-ws",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./server --filter ./client run dev",
    "build": "pnpm -r --filter ./server --filter ./client run build",
    "lint": "pnpm --filter ./client run lint && pnpm --filter ./server run build",
    "dev:server": "pnpm --filter ./server run dev",
    "dev:client": "pnpm --filter ./client run dev",
    "migrate": "pnpm --filter ./server run prisma:migrate",
    "prisma:generate": "pnpm --filter ./server run prisma:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.3.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3",
    "zod": "^3.25.76"
  }
}
